FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app


# ============================================================
# System dependencies
# ============================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*


# ============================================================
# Tailwind CSS binary
#
# این لایه را قبل از COPY پروژه گذاشتیم تا Docker cache
# بتواند آن را در buildهای بعدی reuse کند.
# ============================================================

RUN mkdir -p /app/bin \
    && curl -fL \
        --retry 8 \
        --retry-delay 5 \
        --retry-all-errors \
        --connect-timeout 30 \
        https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64 \
        -o /app/bin/tailwindcss \
    && chmod +x /app/bin/tailwindcss


# ============================================================
# Python dependencies
#
# فقط requirements.txt را ابتدا COPY می‌کنیم.
# بنابراین اگر فقط کد پروژه تغییر کند، این لایه cache می‌شود.
# اگر requirements.txt تغییر کند، pip دوباره اجرا می‌شود.
# ============================================================

COPY requirements.txt .

RUN pip install --upgrade pip \
    && pip install -r requirements.txt


# ============================================================
# Project
# ============================================================

COPY . .


# ============================================================
# Tailwind production build
#
# اینجا پروژه قبلاً COPY شده، بنابراین
# styles/input.css وجود دارد.
# ============================================================

RUN ./bin/tailwindcss \
    -i ./styles/input.css \
    -o ./static/css/output.css \
    --minify


# ============================================================
# Static / Media directories
# ============================================================

RUN mkdir -p /app/staticfiles /app/media


# ============================================================
# Build-time environment variables
#
# فقط برای اینکه Django هنگام collectstatic
# بدون environmentهای واقعی Render اجرا شود.
# مقادیر واقعی در Render Environment Variables قرار می‌گیرند.
# ============================================================

ENV SECRET_KEY=build-time-placeholder \
    DEBUG=False \
    ALLOWED_HOSTS=localhost \
    CSRF_TRUSTED_ORIGINS=http://localhost \
    DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder


# ============================================================
# Collect static files
# ============================================================

RUN python manage.py collectstatic --noinput


# ============================================================
# Runtime
# ============================================================

EXPOSE 8000


CMD ["sh", "-c", "python manage.py migrate && gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 3"]